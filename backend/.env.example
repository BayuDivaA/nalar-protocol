# Port API Hono (default 3000, local development only)
# PORT=3000

# RPC URL for BNB Smart Chain (e.g. Alchemy, QuickNode, or public RPC)
BNB_RPC_URL=https://bnb-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Demo NFT contract address
TXSENTRY_DEMO_NFT=0x4ACCcd7a3d2e2a7c99BE0ea035B40cE03C7A14d1

# AI Provider ("gemini" | "openrouter" | "openai")
AI_PROVIDER=gemini
AI_API_KEY=YOUR_AI_API_KEY
AI_MODEL=gemini-3.5-flash-lite

# ========================================================
# BNB Agent / MCP Investigator Configuration
# ========================================================

# Enable or disable BNB Agent MCP on-chain investigator
BNB_INVESTIGATOR_ENABLED=true

# Transport mode: "stdio" for local dev child process | "sse" for production remote server
# Local Development:
BNB_MCP_TRANSPORT=stdio

# Production (Railway MCP Gateway):
# BNB_MCP_TRANSPORT=sse
# BNB_MCP_URL=https://your-bnb-mcp.up.railway.app/sse
# MCP_AUTH_TOKEN=your-random-shared-secret-here

# Optional: Remote MCP server URL (required when BNB_MCP_TRANSPORT=sse)
BNB_MCP_URL=

# Optional: Bearer authentication token for remote MCP gateway (required when BNB_MCP_TRANSPORT=sse)
MCP_AUTH_TOKEN=

# ========================================================
# Frontend CORS Configuration
# ========================================================

# CORS Frontend Origin for Production (comma-separated if multiple)
FRONTEND_ORIGIN=https://nalar-protocol.xyz