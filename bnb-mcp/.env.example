# BNB MCP gateway configuration. Copy to .env for local use.
# Keep credentials and private RPC URLs out of this public template.

# Node environment ("production" | "development")
NODE_ENV=production

# Public Gateway Port (In Railway/Render, PORT is automatically injected)
PORT=3001
BNB_MCP_PORT=3001

# Internal port for official @bnb-chain/mcp --sse subprocess (default: 3101)
INTERNAL_MCP_PORT=3101

# BSC Network selection (default: bsc-testnet, chainId 97)
BSC_NETWORK=bsc-testnet

# The gateway passes BNB_RPC_URL to its MCP child process.
# BSC Testnet RPC URL (e.g. Alchemy, QuickNode, or public BSC testnet RPC)
BNB_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BNB_MAINNET_RPC_URL=

# Shared authentication secret (must match MCP_AUTH_TOKEN in Nalar backend)
# Accepted aliases: MCP_SHARED_SECRET or BNB_MCP_AUTH_TOKEN or MCP_AUTH_TOKEN
MCP_SHARED_SECRET=your-secure-random-mcp-shared-secret-min-32-chars
BNB_MCP_AUTH_TOKEN=your-secure-random-mcp-shared-secret-min-32-chars

# Logging verbosity ("info" | "debug" | "warn" | "error")
LOG_LEVEL=info
