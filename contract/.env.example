# Foundry deployment configuration for BNB Testnet.
# Copy to .env and replace placeholders locally. Never commit a real private key.

PRIVATE_KEY=<deployer-private-key>
BNB_TESTNET_RPC=<bnb-testnet-rpc-url>

# Optional local record of the deployed demo NFT address.
# TXSENTRY_DEMO_NFT=<deployed-contract-address>
