(() => {
  "use strict";

  if (window.__NALAR_TXSENTRY_INSTALLED__) {
    return;
  }

  window.__NALAR_TXSENTRY_INSTALLED__ = true;

  let requestId = 0;

  const IDS = {
    intent: "__nalar_intent_overlay__",
    decision: "__nalar_decision_overlay__",
    banner: "__nalar_banner__",
  };

  /**
   * ============================================================
   * ETHEREUM PROVIDER
   * ============================================================
   */

  function getEthereum() {
    return window.ethereum;
  }

  /**
   * ============================================================
   * SMALL STATUS BANNER
   * ============================================================
   *
   * Used only for short transitions such as:
   * "Opening wallet..."
   *
   * Security decisions themselves use the full modal.
   */

  function showNalarMessage(message, type = "info") {
    const existing = document.getElementById(IDS.banner);

    if (existing) {
      existing.remove();
    }

    const banner = document.createElement("div");

    banner.id = IDS.banner;

    Object.assign(banner.style, {
      position: "fixed",
      left: "50%",
      bottom: "24px",
      transform: "translateX(-50%)",
      zIndex: "2147483647",

      maxWidth: "min(520px, calc(100vw - 32px))",

      padding: "11px 15px",

      background: "#0a0a0a",
      color: "#f5f5f5",

      border: type === "block" ? "1px solid #525252" : "1px solid #333333",

      borderRadius: "8px",

      boxShadow: "0 14px 34px rgba(0,0,0,.35)",

      fontFamily: "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",

      fontSize: "12px",
      lineHeight: "1.45",
      fontWeight: "500",

      letterSpacing: "0.01em",

      pointerEvents: "none",
    });

    banner.textContent = message;

    document.documentElement.appendChild(banner);

    setTimeout(() => {
      banner.remove();
    }, 3200);
  }

  /**
   * ============================================================
   * INSTALL INTERCEPTOR
   * ============================================================
   */

  function install() {
    const ethereum = getEthereum();

    if (!ethereum) {
      return false;
    }

    const originalRequest = ethereum.request?.bind(ethereum);

    if (!originalRequest) {
      return false;
    }

    const pendingRequests = new Map();

    ethereum.request = async function (args) {
      /**
       * We only intercept normal transaction submission.
       *
       * Other provider methods continue untouched.
       */
      if (!args || args.method !== "eth_sendTransaction") {
        return originalRequest(args);
      }

      /**
       * --------------------------------------------------------
       * Protection status
       * --------------------------------------------------------
       */

      const protectionEnabled = await getProtectionStatus();

      if (!protectionEnabled) {
        console.info("[Nalar] Protection paused. Forwarding transaction directly.");

        return originalRequest(args);
      }

      /**
       * --------------------------------------------------------
       * Transaction validation
       * --------------------------------------------------------
       */

      const transaction = args.params?.[0];

      if (!transaction) {
        throw new Error("[Nalar] Missing transaction request.");
      }

      if (!transaction.to) {
        throw new Error("[Nalar] Transaction target is missing.");
      }

      /**
       * --------------------------------------------------------
       * Intent
       * --------------------------------------------------------
       *
       * Always let the user see and confirm the intent.
       *
       * This avoids silently applying an old intent to
       * a new transaction.
       */

      const storedIntent = await getStoredIntent();

      const confirmedIntent = await showIntentOverlay(storedIntent);

      if (typeof confirmedIntent !== "string" || !confirmedIntent.trim()) {
        throw new Error("[Nalar] Transaction cancelled because no intent was provided.");
      }

      const intent = confirmedIntent.trim();

      /**
       * The overlay itself does not persist the intent.
       * Persist exactly once here.
       */
      await saveIntent(intent);

      /**
       * --------------------------------------------------------
       * Chain
       * --------------------------------------------------------
       */

      const chainId = await originalRequest({
        method: "eth_chainId",
      });

      const id = ++requestId;

      /**
       * --------------------------------------------------------
       * Security request
       * --------------------------------------------------------
       */

      return new Promise((resolve, reject) => {
        const timeout = setTimeout(() => {
          cleanup();

          reject(new Error("[Nalar] Security check timed out."));
        }, 30_000);

        function cleanup() {
          clearTimeout(timeout);

          pendingRequests.delete(id);

          window.removeEventListener("message", handleMessage);
        }

        async function continueToWallet() {
          showNalarMessage("Nalar cleared the transaction. Opening wallet...");

          try {
            const result = await originalRequest({
              ...args,

              params: [
                {
                  ...transaction,
                  from: transaction.from,
                },
              ],
            });

            resolve(result);
          } catch (error) {
            reject(error);
          }
        }

        function cancelTransaction(message) {
          reject(new Error(message ?? "[Nalar] Transaction cancelled by user."));
        }

        function handleMessage(event) {
          if (event.source !== window) {
            return;
          }

          const message = event.data;

          if (!message || message.source !== "NALAR_EXTENSION") {
            return;
          }

          if (message.type !== "TX_RESULT") {
            return;
          }

          /**
           * CRITICAL:
           *
           * Response must belong to the exact
           * transaction currently waiting.
           */
          if (message.id !== id || !pendingRequests.has(id)) {
            return;
          }

          cleanup();

          const security = message.security;

          if (!security) {
            reject(new Error("[Nalar] Invalid security response."));

            return;
          }

          /**
           * ----------------------------------------------------
           * BLOCK
           * ----------------------------------------------------
           *
           * Never call wallet here.
           */
          if (security.decision === "BLOCK") {
            showDecisionOverlay(security, "BLOCK", null, () => {
              cancelTransaction("[Nalar] Transaction blocked by TxSentry.");
            });

            return;
          }

          /**
           * ----------------------------------------------------
           * REVIEW
           * ----------------------------------------------------
           */
          if (security.decision === "REVIEW") {
            showDecisionOverlay(security, "REVIEW", continueToWallet, () => {
              cancelTransaction("[Nalar] Transaction cancelled during review.");
            });

            return;
          }

          /**
           * ----------------------------------------------------
           * ALLOW
           * ----------------------------------------------------
           */
          showDecisionOverlay(security, "ALLOW", continueToWallet, () => {
            cancelTransaction("[Nalar] Transaction cancelled by user.");
          });
        }

        /**
         * Register listener BEFORE sending message.
         *
         * Prevents missing a fast response from the bridge.
         */
        pendingRequests.set(id, {
          transaction,
          chainId,
          intent,
        });

        window.addEventListener("message", handleMessage);

        window.postMessage(
          {
            source: "NALAR_PAGE",

            type: "TX_REQUEST",

            id,

            chainId,

            transaction,
          },
          "*",
        );
      });
    };

    console.info("[Nalar] TxSentry interceptor installed.");

    return true;
  }

  /**
   * ============================================================
   * DECISION OVERLAY
   * ============================================================
   *
   * One component for:
   * ALLOW / REVIEW / BLOCK
   *
   * Visual language:
   * black + white
   * thin borders
   * restrained radius
   * no gradients
   * no neon
   * no excessive decoration
   */

  function showDecisionOverlay(security, decision, onContinue, onCancel) {
    const existing = document.getElementById(IDS.decision);

    if (existing) {
      existing.remove();
    }

    const overlay = document.createElement("div");

    overlay.id = IDS.decision;

    Object.assign(overlay.style, {
      position: "fixed",
      inset: "0",

      zIndex: "2147483647",

      display: "flex",
      alignItems: "center",
      justifyContent: "center",

      padding: "20px",

      background: "rgba(0,0,0,.72)",

      backdropFilter: "blur(4px)",
      WebkitBackdropFilter: "blur(4px)",

      fontFamily: "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",

      boxSizing: "border-box",
    });

    const modal = document.createElement("div");

    Object.assign(modal.style, {
      width: "min(560px, 100%)",

      maxHeight: "calc(100vh - 40px)",

      overflowY: "auto",

      background: "#0a0a0a",

      color: "#f5f5f5",

      border: "1px solid #303030",

      borderRadius: "12px",

      boxShadow: "0 28px 90px rgba(0,0,0,.55)",

      boxSizing: "border-box",
    });

    const explanation = security.explanation ?? {};

    const transactionSummary = security.transactionSummary ?? {};

    const intent = security.intent?.description ?? security.intent?.raw ?? "No intent description available.";

    const actualAction = security.actual?.functionName ?? security.actual?.action ?? "Unknown";

    const riskLevel = security.riskLevel ?? "UNKNOWN";

    const riskScore = security.riskScore ?? 0;

    const summary = explanation.summary ?? getFallbackSummary(security, decision);

    const details = Array.isArray(explanation.details) ? explanation.details : [];

    const reasons = dedupe([...(security.reasons ?? []), ...(security.comparison?.mismatches ?? []), ...(security.policy?.evaluation?.reasons ?? [])]);

    const status = getDecisionStatus(decision);

    const title = explanation.title ?? status.title;

    const actionLabel = transactionSummary.title ?? transactionSummary.action ?? actualAction;

    const actionDescription = transactionSummary.description ?? security.actual?.description ?? "Nalar analyzed this transaction.";

    const transactionDetails = Array.isArray(transactionSummary.details) ? transactionSummary.details : [];

    const recipient = transactionSummary.target ?? null;

    /**
     * ----------------------------------------------------------
     * HEADER
     * ----------------------------------------------------------
     */

    const header = document.createElement("div");

    Object.assign(header.style, {
      padding: "22px 22px 18px",

      borderBottom: "1px solid #242424",

      display: "flex",

      justifyContent: "space-between",

      alignItems: "flex-start",

      gap: "20px",
    });

    const headerLeft = document.createElement("div");

    const eyebrow = document.createElement("div");

    eyebrow.textContent = "NALAR / TXSENTRY";

    Object.assign(eyebrow.style, {
      fontSize: "9px",

      lineHeight: "1",

      letterSpacing: ".22em",

      color: "#717171",

      textTransform: "uppercase",

      fontWeight: "600",
    });

    const heading = document.createElement("h2");

    heading.textContent = title;

    Object.assign(heading.style, {
      margin: "11px 0 0",

      fontSize: "25px",

      lineHeight: "1.15",

      letterSpacing: "-.035em",

      fontWeight: "600",

      color: "#f5f5f5",
    });

    const statusText = document.createElement("div");

    statusText.textContent = status.label;

    Object.assign(statusText.style, {
      marginTop: "8px",

      fontSize: "12px",

      color: "#9a9a9a",

      lineHeight: "1.4",
    });

    headerLeft.appendChild(eyebrow);

    headerLeft.appendChild(heading);

    headerLeft.appendChild(statusText);

    const score = document.createElement("div");

    Object.assign(score.style, {
      minWidth: "82px",

      padding: "10px 11px",

      border: "1px solid #343434",

      borderRadius: "8px",

      textAlign: "right",

      flex: "0 0 auto",
    });

    const scoreLabel = document.createElement("div");

    scoreLabel.textContent = "RISK";

    Object.assign(scoreLabel.style, {
      fontSize: "8px",

      letterSpacing: ".16em",

      color: "#686868",

      fontWeight: "600",
    });

    const scoreValue = document.createElement("div");

    scoreValue.textContent = `${riskScore}/100`;

    Object.assign(scoreValue.style, {
      marginTop: "5px",

      fontSize: "14px",

      fontWeight: "650",

      letterSpacing: "-.02em",

      color: "#f5f5f5",
    });

    score.appendChild(scoreLabel);
    score.appendChild(scoreValue);

    header.appendChild(headerLeft);
    header.appendChild(score);

    /**
     * ----------------------------------------------------------
     * BODY
     * ----------------------------------------------------------
     */

    const body = document.createElement("div");

    Object.assign(body.style, {
      padding: "22px",
    });

    /**
     * Intent block
     */

    body.appendChild(createSection("WHAT YOU ASKED", createTextBlock(intent)));

    /**
     * Actual transaction
     */

    const actionContent = document.createElement("div");

    const actionTitle = document.createElement("div");

    actionTitle.textContent = actionLabel;

    Object.assign(actionTitle.style, {
      fontSize: "17px",

      fontWeight: "600",

      lineHeight: "1.3",

      letterSpacing: "-.02em",

      color: "#f5f5f5",
    });

    const actionDescriptionElement = document.createElement("div");

    actionDescriptionElement.textContent = actionDescription;

    Object.assign(actionDescriptionElement.style, {
      marginTop: "7px",

      fontSize: "13px",

      lineHeight: "1.65",

      color: "#b0b0b0",
    });

    actionContent.appendChild(actionTitle);

    actionContent.appendChild(actionDescriptionElement);

    if (transactionDetails.length > 0) {
      const detailList = document.createElement("div");

      Object.assign(detailList.style, {
        marginTop: "13px",

        paddingTop: "13px",

        borderTop: "1px solid #202020",
      });

      transactionDetails.slice(0, 5).forEach((detail) => {
        const row = document.createElement("div");

        row.textContent = detail;

        Object.assign(row.style, {
          marginBottom: "6px",

          fontSize: "12px",

          lineHeight: "1.5",

          color: "#858585",
        });

        detailList.appendChild(row);
      });

      actionContent.appendChild(detailList);
    }

    if (recipient) {
      const target = document.createElement("div");

      target.textContent = `Target  ${formatAddress(recipient)}`;

      Object.assign(target.style, {
        marginTop: "13px",

        paddingTop: "13px",

        borderTop: "1px solid #202020",

        fontSize: "11px",

        color: "#777777",

        fontFamily: "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
      });

      actionContent.appendChild(target);
    }

    body.appendChild(createSection("WHAT WILL HAPPEN", actionContent));

    /**
     * Explanation
     */

    const explanationContent = document.createElement("div");

    const summaryElement = document.createElement("div");

    summaryElement.textContent = summary;

    Object.assign(summaryElement.style, {
      fontSize: "14px",

      lineHeight: "1.7",

      color: "#d0d0d0",
    });

    explanationContent.appendChild(summaryElement);

    const combinedDetails = dedupe([...details, ...(decision === "BLOCK" ? reasons : [])]);

    if (combinedDetails.length > 0) {
      const list = document.createElement("div");

      Object.assign(list.style, {
        marginTop: "14px",
      });

      combinedDetails.slice(0, 5).forEach((detail) => {
        const item = document.createElement("div");

        item.textContent = `— ${detail}`;

        Object.assign(item.style, {
          marginBottom: "7px",

          fontSize: "12px",

          lineHeight: "1.55",

          color: "#858585",
        });

        list.appendChild(item);
      });

      explanationContent.appendChild(list);
    }

    body.appendChild(createSection(decision === "BLOCK" ? "WHY NALAR STOPPED IT" : "NALAR ANALYSIS", explanationContent));

    /**
     * ----------------------------------------------------------
     * FOOTER
     * ----------------------------------------------------------
     */

    const footer = document.createElement("div");

    Object.assign(footer.style, {
      padding: "0 22px 22px",
    });

    const footerNote = document.createElement("div");

    footerNote.textContent = getFooterNote(decision);

    Object.assign(footerNote.style, {
      marginBottom: "16px",

      fontSize: "11px",

      lineHeight: "1.55",

      color: "#626262",
    });

    footer.appendChild(footerNote);

    const actions = document.createElement("div");

    Object.assign(actions.style, {
      display: "grid",

      gridTemplateColumns: decision === "BLOCK" ? "1fr" : "140px 1fr",

      gap: "8px",
    });

    const cancelButton = document.createElement("button");

    cancelButton.textContent = decision === "BLOCK" ? "Close" : "Cancel";

    styleButton(cancelButton, false);

    cancelButton.addEventListener("click", () => {
      overlay.remove();

      if (onCancel) {
        onCancel();
      }
    });

    actions.appendChild(cancelButton);

    if (decision !== "BLOCK") {
      const continueButton = document.createElement("button");

      continueButton.textContent = decision === "ALLOW" ? "Continue to wallet" : "Continue anyway";

      styleButton(continueButton, true);

      continueButton.addEventListener("click", () => {
        overlay.remove();

        if (onContinue) {
          onContinue();
        }
      });

      actions.appendChild(continueButton);
    }

    footer.appendChild(actions);

    /**
     * ----------------------------------------------------------
     * COMPOSE
     * ----------------------------------------------------------
     */

    modal.appendChild(header);

    modal.appendChild(body);

    modal.appendChild(footer);

    overlay.appendChild(modal);

    document.documentElement.appendChild(overlay);

    /**
     * ----------------------------------------------------------
     * ESCAPE
     * ----------------------------------------------------------
     */

    function handleEscape(event) {
      if (event.key !== "Escape") {
        return;
      }

      document.removeEventListener("keydown", handleEscape);

      overlay.remove();

      if (onCancel) {
        onCancel();
      }
    }

    document.addEventListener("keydown", handleEscape);
  }

  /**
   * ============================================================
   * SECTION HELPER
   * ============================================================
   */

  function createSection(label, content) {
    const section = document.createElement("section");

    Object.assign(section.style, {
      padding: "16px 0",

      borderBottom: "1px solid #202020",
    });

    const labelElement = document.createElement("div");

    labelElement.textContent = label;

    Object.assign(labelElement.style, {
      marginBottom: "9px",

      fontSize: "9px",

      letterSpacing: ".18em",

      color: "#666666",

      textTransform: "uppercase",

      fontWeight: "600",
    });

    section.appendChild(labelElement);

    section.appendChild(content);

    return section;
  }

  function createTextBlock(text) {
    const element = document.createElement("div");

    element.textContent = text;

    Object.assign(element.style, {
      fontSize: "14px",

      lineHeight: "1.65",

      color: "#d0d0d0",
    });

    return element;
  }

  /**
   * ============================================================
   * BUTTON STYLE
   * ============================================================
   */

  function styleButton(button, primary) {
    Object.assign(button.style, {
      minHeight: "44px",

      padding: "0 15px",

      borderRadius: "8px",

      border: primary ? "1px solid #f5f5f5" : "1px solid #353535",

      background: primary ? "#f5f5f5" : "#0a0a0a",

      color: primary ? "#0a0a0a" : "#d7d7d7",

      fontFamily: "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",

      fontSize: "12px",

      fontWeight: "600",

      letterSpacing: ".005em",

      cursor: "pointer",

      transition: "background .12s ease, color .12s ease, border-color .12s ease",
    });

    button.addEventListener("mouseenter", () => {
      if (primary) {
        button.style.background = "#ffffff";
      } else {
        button.style.borderColor = "#525252";
      }
    });

    button.addEventListener("mouseleave", () => {
      if (primary) {
        button.style.background = "#f5f5f5";
      } else {
        button.style.borderColor = "#353535";
      }
    });
  }

  /**
   * ============================================================
   * DECISION STATUS
   * ============================================================
   */

  function getDecisionStatus(decision) {
    switch (decision) {
      case "ALLOW":
        return {
          title: "Transaction looks safe",

          label: "Security check passed",
        };

      case "REVIEW":
        return {
          title: "Review required",

          label: "Manual confirmation required",
        };

      case "BLOCK":
        return {
          title: "Transaction blocked",

          label: "Nalar stopped the request",
        };

      default:
        return {
          title: "Transaction result",

          label: "Security analysis completed",
        };
    }
  }

  /**
   * ============================================================
   * FALLBACK EXPLANATION
   * ============================================================
   */

  function getFallbackSummary(security, decision) {
    if (decision === "BLOCK") {
      if (security.intentMatch === false) {
        return "The transaction does not match what you asked to do, so Nalar stopped it before signing.";
      }

      return "Nalar found a security condition that does not allow this transaction to continue.";
    }

    if (decision === "REVIEW") {
      return "This transaction can continue, but Nalar found something that should be checked before signing.";
    }

    return "Nalar found that the transaction is consistent with your requested action.";
  }

  /**
   * ============================================================
   * FOOTER COPY
   * ============================================================
   */

  function getFooterNote(decision) {
    if (decision === "BLOCK") {
      return "The transaction was stopped before your wallet was asked to sign it.";
    }

    if (decision === "REVIEW") {
      return "Continuing will send the original transaction to your wallet for final confirmation.";
    }

    return "Nalar has completed its security check. Your wallet will ask for final confirmation next.";
  }

  /**
   * ============================================================
   * HELPERS
   * ============================================================
   */

  function dedupe(values) {
    return [
      ...new Set(
        values
          .filter((value) => typeof value === "string")
          .map((value) => value.trim())
          .filter(Boolean),
      ),
    ];
  }

  function formatAddress(address) {
    if (typeof address !== "string") {
      return String(address);
    }

    if (!/^0x[a-fA-F0-9]{40}$/.test(address)) {
      return address;
    }

    return `${address.slice(0, 6)}…${address.slice(-4)}`;
  }

  /**
   * ============================================================
   * INTENT OVERLAY
   * ============================================================
   */

  function showIntentOverlay(existingIntent = "") {
    return new Promise((resolve) => {
      const existing = document.getElementById(IDS.intent);

      if (existing) {
        existing.remove();
      }

      const overlay = document.createElement("div");

      overlay.id = IDS.intent;

      Object.assign(overlay.style, {
        position: "fixed",

        inset: "0",

        zIndex: "2147483647",

        display: "flex",

        alignItems: "center",

        justifyContent: "center",

        padding: "20px",

        background: "rgba(0,0,0,.72)",

        backdropFilter: "blur(4px)",

        WebkitBackdropFilter: "blur(4px)",

        fontFamily: "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",

        boxSizing: "border-box",
      });

      const modal = document.createElement("div");

      Object.assign(modal.style, {
        width: "min(540px, 100%)",

        background: "#0a0a0a",

        border: "1px solid #303030",

        borderRadius: "12px",

        color: "#f5f5f5",

        boxShadow: "0 28px 90px rgba(0,0,0,.55)",

        boxSizing: "border-box",

        overflow: "hidden",
      });

      /**
       * Header
       */

      const header = document.createElement("div");

      Object.assign(header.style, {
        padding: "21px 22px 17px",

        borderBottom: "1px solid #232323",
      });

      const eyebrow = document.createElement("div");

      eyebrow.textContent = "NALAR / TXSENTRY";

      Object.assign(eyebrow.style, {
        fontSize: "9px",

        letterSpacing: ".22em",

        fontWeight: "600",

        color: "#707070",

        textTransform: "uppercase",
      });

      const title = document.createElement("h2");

      title.textContent = "What are you trying to do?";

      Object.assign(title.style, {
        margin: "11px 0 0",

        fontSize: "25px",

        lineHeight: "1.15",

        fontWeight: "600",

        letterSpacing: "-.035em",

        color: "#f5f5f5",
      });

      const description = document.createElement("p");

      description.textContent = "State your intention before Nalar checks the transaction.";

      Object.assign(description.style, {
        margin: "9px 0 0",

        fontSize: "13px",

        lineHeight: "1.6",

        color: "#868686",

        maxWidth: "450px",
      });

      header.appendChild(eyebrow);

      header.appendChild(title);

      header.appendChild(description);

      /**
       * Body
       */

      const body = document.createElement("div");

      Object.assign(body.style, {
        padding: "22px",
      });

      /**
       * Origin
       */

      const originLabel = document.createElement("div");

      originLabel.textContent = "REQUEST FROM";

      Object.assign(originLabel.style, {
        fontSize: "9px",

        letterSpacing: ".18em",

        fontWeight: "600",

        color: "#626262",

        textTransform: "uppercase",
      });

      const origin = document.createElement("div");

      origin.textContent = window.location.hostname || "Current website";

      Object.assign(origin.style, {
        marginTop: "8px",

        padding: "10px 11px",

        border: "1px solid #292929",

        borderRadius: "7px",

        background: "#050505",

        fontSize: "12px",

        color: "#aaaaaa",

        overflow: "hidden",

        textOverflow: "ellipsis",

        whiteSpace: "nowrap",
      });

      body.appendChild(originLabel);

      body.appendChild(origin);

      /**
       * Intent label
       */

      const intentLabel = document.createElement("div");

      intentLabel.textContent = "YOUR INTENT";

      Object.assign(intentLabel.style, {
        marginTop: "22px",

        marginBottom: "9px",

        fontSize: "9px",

        letterSpacing: ".18em",

        fontWeight: "600",

        color: "#626262",

        textTransform: "uppercase",
      });

      /**
       * Textarea
       */

      const textarea = document.createElement("textarea");

      textarea.value = typeof existingIntent === "string" ? existingIntent : "";

      textarea.placeholder = "Example: Mint 1 NFT for 0.02 BNB";

      Object.assign(textarea.style, {
        display: "block",

        width: "100%",

        minHeight: "124px",

        padding: "13px",

        resize: "vertical",

        border: "1px solid #343434",

        borderRadius: "8px",

        outline: "none",

        background: "#050505",

        color: "#eeeeee",

        caretColor: "#ffffff",

        fontFamily: "inherit",

        fontSize: "13px",

        lineHeight: "1.6",

        boxSizing: "border-box",
      });

      textarea.addEventListener("focus", () => {
        textarea.style.borderColor = "#676767";
      });

      textarea.addEventListener("blur", () => {
        textarea.style.borderColor = "#343434";
      });

      body.appendChild(intentLabel);

      body.appendChild(textarea);

      /**
       * Helper note
       */

      const note = document.createElement("div");

      note.textContent = "Nalar compares this statement with the transaction before your wallet is asked to sign.";

      Object.assign(note.style, {
        marginTop: "10px",

        fontSize: "11px",

        lineHeight: "1.55",

        color: "#626262",
      });

      body.appendChild(note);

      /**
       * Footer
       */

      const footer = document.createElement("div");

      Object.assign(footer.style, {
        padding: "0 22px 22px",
      });

      const actions = document.createElement("div");

      Object.assign(actions.style, {
        display: "grid",

        gridTemplateColumns: "140px 1fr",

        gap: "8px",
      });

      const cancelButton = document.createElement("button");

      cancelButton.textContent = "Cancel";

      styleButton(cancelButton, false);

      cancelButton.addEventListener("click", () => {
        overlay.remove();

        resolve(null);
      });

      const continueButton = document.createElement("button");

      continueButton.textContent = "Analyze transaction";

      styleButton(continueButton, true);

      continueButton.addEventListener("click", () => {
        const intent = textarea.value.trim();

        if (!intent) {
          textarea.style.borderColor = "#8a8a8a";

          note.textContent = "Please describe what you are trying to do.";

          note.style.color = "#aaaaaa";

          textarea.focus();

          return;
        }

        overlay.remove();

        resolve(intent);
      });

      actions.appendChild(cancelButton);

      actions.appendChild(continueButton);

      footer.appendChild(actions);

      /**
       * Compose
       */

      modal.appendChild(header);

      modal.appendChild(body);

      modal.appendChild(footer);

      overlay.appendChild(modal);

      document.documentElement.appendChild(overlay);

      /**
       * Autofocus
       */

      setTimeout(() => {
        textarea.focus();

        try {
          textarea.setSelectionRange(textarea.value.length, textarea.value.length);
        } catch {
          // Ignore selection errors.
        }
      }, 0);

      /**
       * Keyboard shortcuts
       */

      function onKeydown(event) {
        if (event.key === "Escape") {
          document.removeEventListener("keydown", onKeydown);

          overlay.remove();

          resolve(null);

          return;
        }

        if ((event.ctrlKey || event.metaKey) && event.key === "Enter") {
          event.preventDefault();

          continueButton.click();
        }
      }

      document.addEventListener("keydown", onKeydown);
    });
  }

  /**
   * ============================================================
   * GET STORED INTENT
   * ============================================================
   */

  async function getStoredIntent() {
    const id = `intent-${Date.now()}-${Math.random()}`;

    return new Promise((resolve) => {
      let completed = false;

      const timeout = setTimeout(() => {
        if (completed) {
          return;
        }

        completed = true;

        window.removeEventListener("message", handleMessage);

        /**
         * Fail closed.
         *
         * No stored intent is safer than
         * silently bypassing the intent layer.
         */
        resolve(null);
      }, 3000);

      function handleMessage(event) {
        if (completed || event.source !== window) {
          return;
        }

        const message = event.data;

        if (!message || message.source !== "NALAR_EXTENSION") {
          return;
        }

        if (message.type !== "INTENT_RESULT" || message.id !== id) {
          return;
        }

        completed = true;

        clearTimeout(timeout);

        window.removeEventListener("message", handleMessage);

        resolve(typeof message.intent === "string" ? message.intent : null);
      }

      window.addEventListener("message", handleMessage);

      window.postMessage(
        {
          source: "NALAR_PAGE",

          type: "GET_INTENT",

          id,
        },
        "*",
      );
    });
  }

  /**
   * ============================================================
   * SAVE INTENT
   * ============================================================
   */

  async function saveIntent(intent) {
    const id = `save-intent-${Date.now()}-${Math.random()}`;

    return new Promise((resolve, reject) => {
      let completed = false;

      const timeout = setTimeout(() => {
        if (completed) {
          return;
        }

        completed = true;

        window.removeEventListener("message", handleMessage);

        reject(new Error("Saving intent timed out."));
      }, 3000);

      function handleMessage(event) {
        if (completed || event.source !== window) {
          return;
        }

        const message = event.data;

        if (!message || message.source !== "NALAR_EXTENSION") {
          return;
        }

        if (message.type !== "INTENT_SAVED" || message.id !== id) {
          return;
        }

        completed = true;

        clearTimeout(timeout);

        window.removeEventListener("message", handleMessage);

        if (message.ok) {
          resolve(true);

          return;
        }

        reject(new Error(message.error ?? "Failed to save intent."));
      }

      window.addEventListener("message", handleMessage);

      window.postMessage(
        {
          source: "NALAR_PAGE",

          type: "SET_INTENT",

          id,

          intent,
        },
        "*",
      );
    });
  }

  /**
   * ============================================================
   * PROTECTION STATUS
   * ============================================================
   */

  async function getProtectionStatus() {
    const id = `protection-${Date.now()}-${Math.random()}`;

    return new Promise((resolve, reject) => {
      let completed = false;

      const timeout = setTimeout(() => {
        if (completed) {
          return;
        }

        completed = true;

        window.removeEventListener("message", handleMessage);

        reject(new Error("[Nalar] Unable to determine protection status."));
      }, 3000);

      function handleMessage(event) {
        if (completed || event.source !== window) {
          return;
        }

        const message = event.data;

        if (!message || message.source !== "NALAR_EXTENSION") {
          return;
        }

        if (message.type !== "PROTECTION_STATUS" || message.id !== id) {
          return;
        }

        completed = true;

        clearTimeout(timeout);

        window.removeEventListener("message", handleMessage);

        if (message.error) {
          reject(new Error(message.error));

          return;
        }

        resolve(message.enabled === true);
      }

      window.addEventListener("message", handleMessage);

      window.postMessage(
        {
          source: "NALAR_PAGE",

          type: "GET_PROTECTION_STATUS",

          id,
        },
        "*",
      );
    });
  }

  /**
   * ============================================================
   * PROVIDER DETECTION
   * ============================================================
   *
   * Wallets may load after document_start.
   * Retry for a limited period.
   */

  let attempts = 0;

  const maxAttempts = 100;

  const timer = setInterval(() => {
    attempts += 1;

    if (install()) {
      clearInterval(timer);

      return;
    }

    if (attempts >= maxAttempts) {
      clearInterval(timer);

      console.warn("[Nalar] Wallet provider was not detected.");
    }
  }, 50);
})();
