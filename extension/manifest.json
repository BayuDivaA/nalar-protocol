{
  "manifest_version": 3,
  "name": "Nalar Protocol",
  "version": "0.1.0",
  "description": "Intent-aware Web3 transaction security by Nalar Protocol.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://nalar-protocol.vercel.app/*", "http://localhost:3001/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nalar Protocol",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/n-dark.svg",
      "32": "icons/n-dark.svg",
      "48": "icons/n-dark.svg",
      "128": "icons/n-dark.svg"
    }
  },
  "icons": {
    "16": "icons/n-dark.svg",
    "32": "icons/n-dark.svg",
    "48": "icons/n-dark.svg",
    "128": "icons/n-dark.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "css": ["ui.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
