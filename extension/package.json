{
  "scripts": {
    "build:injected": "esbuild src/injected/index.js --bundle --format=iife --platform=browser --outfile=dist/injected.js",
    "build:content": "esbuild src/content/content.js --bundle --format=iife --platform=browser --outfile=content.js",
    "build:background": "esbuild src/background/background.js --bundle --format=iife --platform=browser --outfile=background.js",
    "build": "bun run build:injected && bun run build:content && bun run build:background"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
